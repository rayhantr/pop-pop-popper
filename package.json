{
  "name": "pop-pop-popper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kid-friendly balloon popper game controlled by hand gestures through your camera",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "generate:assets": "node scripts/seo-assets.mjs",
    "prebuild": "node scripts/seo-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "sharp": "^0.35.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
