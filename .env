# Canonical absolute origin (no trailing slash). Single source of truth for all
# absolute SEO URLs: Vite substitutes %VITE_SITE_URL% into index.html at build
# time (canonical, Open Graph, Twitter, JSON-LD). Change this when deploying to
# a different domain — and update the literal URLs in public/robots.txt,
# public/sitemap.xml and public/.well-known/security.txt to match.
VITE_SITE_URL=https://popr.sindbug.com
